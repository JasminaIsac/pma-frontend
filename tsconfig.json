{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "types": ["react-native", "react"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["app/*"],
      "@components/*": ["components/*"],
      "@utils/*": ["utils/*"],
      "@hooks/*": ["hooks/*"],
      "@assets/*": ["assets/*"],
      "@contexts/*": ["contexts/*"],
      "@constants/*": ["constants/*"],
      "@api/*": ["api/*"],
      "@theme/*": ["theme/*"],
      "@schemas/*": ["schemas/*"]
    }
  },
  "exclude": ["node_modules"]
}
